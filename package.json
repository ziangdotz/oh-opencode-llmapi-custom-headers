{
  "name": "opencode-llmapi-custom-headers",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./tui": "./src/tui.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "tools/harden-development.mjs",
    "docs",
    "examples",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "postinstall": "node tools/harden-development.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:tui": "bun test/editor.render.ts",
    "check:package": "tsx tools/check-package.ts",
    "verify:release": "npm run verify && npm run test:tui && npm run check:package",
    "prepack": "npm run verify:release",
    "test:host": "tsx tools/host-wire.ts",
    "test:host:smoke": "tsx tools/host-smoke.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run check && npm test"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@opencode/plugin": "2.4.2",
    "@opencode/theme": "2.4.2",
    "@opentui/core": "0.9.9",
    "@opentui/solid": "0.9.9",
    "@types/node": "24.10.1",
    "prettier": "3.10.1",
    "solid-js": "1.9.17",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "glob": "14.0.6",
    "minimatch": "11.0.9",
    "esbuild": "0.28.1"
  },
  "description": "OpenCode V2 TUI plugin for custom LLM routes, API headers and model discovery.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziangdotz/oh-opencode-llmapi-custom-headers.git"
  },
  "homepage": "https://github.com/ziangdotz/oh-opencode-llmapi-custom-headers#readme",
  "bugs": {
    "url": "https://github.com/ziangdotz/oh-opencode-llmapi-custom-headers/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "llm",
    "custom-headers",
    "tui"
  ],
  "engines": {
    "node": ">=22"
  }
}
