  "version": 1,
  "providers": {
    "gateway": {
      "api": "openai-completions",
      "baseURL": "https://gateway.example/v1",
      "headers": {
        "User-Agent": "codex_cli_rs/0.169.0-alpha.11.1",
        "originator": "codex_cli_rs"
      },
      "models": [
        {
          "id": "model-name",
          "contextWindow": 262144,
